// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Attempt {
  id Int @id @default(autoincrement())

  name            String
  startTime       BigInt // Will get ms in backend and do math to find attempt duration (startTime - endTime)
  endTime         BigInt
  attemptDuration BigInt
  clicks          Int      @default(0)
  score           Int
  attemptDate     DateTime @default(now())
  charactersFound Int      @default(0)
  char1Alive      Boolean  @default(true)
  char2Alive      Boolean  @default(true)
  char3Alive      Boolean  @default(true)
  status          Status   @default(ONGOING)

  records   Records   @relation(fields: [levelName], references: [levelName], onDelete: Cascade)
  levelName LevelName
}

model Records {
  id Int @id @default(autoincrement())

  attempts  Attempt[]
  levelName LevelName @unique
}

enum LevelName {
  PIRATES
  AIRPORT
  LIBRARY
}

enum Status {
  ONGOING
  COMPLETED
  ABANDON
}
